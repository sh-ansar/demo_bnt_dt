{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "cleanUrls": true,

  "trailingSlash": false,

  "rewrites": [
    {
      "source": "/digital-twin",
      "destination": "/digital-twin.html"
    }
  ],

  "headers": [
    {
      "source": "/api/config",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
